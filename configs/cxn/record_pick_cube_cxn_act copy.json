    "action_compose": "obs_joints_action_gripper",
    "action_compose_repo_id": "local/cube_v727_cxn_ojag",
    "action_compose_overwrite": false,
    "camera_scales": {
      "cam_right": 1.0,
      "cam_side": 1.0,
      "cam_top": 1.0
    },
    "learnable_camera_scales": false,
    "use_camera_id_embed": true,
    "chunk_size": 200,
    "n_action_steps": 100,
    "device": "cuda",
    "steps": 10000,
    "batch_size": 4,
    "log_freq": 100,
