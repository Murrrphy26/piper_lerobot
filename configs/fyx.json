{
  "task": "pick up the orange cube from the table and put it in the bowl",
  "dataset_format": "lerobot",
  "repo_id": "local/cube_cam_adjustment",
  "root": "data/lerobot",
  "robot_type": "piper",
  "no_videos": false,
  "prompt_outcome": true,
  "episode_outcome": "skip",
  "output_dir": "data/raw",
  "fps": 10.0,
  "duration": null,
  "follower_left_can": null,
  "follower_right_can": "can0",
  "leader_left_can": null,
  "leader_right_can": "can0",
  "camera_width": 640,
  "camera_height": 480,
  "camera_fps": 30,
  "image_format": "jpg",
  "image_quality": 95,
  "action_source": "leader",
  "recording_notes": "本地 ACT：cube_pi05_v5 离线 SG 平滑后重训；腕相权重 2.5。",
  "training": {
    "policy_type": "act_piper",
    "job_name": "cube_cam_adjustment",
    "output_dir": "outputs/train/cube_cam_adjustment",
    "camera_names": ["cam_right", "cam_front", "cam_side"],
    "camera_scales": {
      "cam_right": 1.0,
      "cam_side": 1.0,
      "cam_front": 1.0
    },
    "learnable_camera_scales": false,
    "use_camera_id_embed": true,
    "chunk_size": 100,
    "n_action_steps": 50,
    "device": "cuda",
    "steps": 10000,
    "batch_size": 4,
    "log_freq": 100,
    "save_freq": 1000,
    "wandb_enable": false,
    "video_backend": "pyav",
    "outcome_filter": "exclude-failures",
    "include_unknown": false,
    "exclude_unlabeled": true,
    "push_to_hub": false,
    "pytorch_alloc_conf": "expandable_segments:True"
  },
  "policy_live": {
    "policy_path": "outputs/train/cube_cam_adjustment/checkpoints/last/pretrained_model",
    "repo_id": "local/cube_cam_adjustment",
    "dataset_root": "data/lerobot/local/cube_cam_adjustment",
    "video_backend": "pyav",
    "device": "cuda",
    "execute": true,
    "duration": 60.0,
    "fps": 20.0,
    "control_hz": 20.0,
    "use_action_chunk_stream": true,
    "prefetch_remaining": 15,
    "chunk_blend_steps": 15,
    "n_action_steps": 50,
    "control_speed": 12,
    "max_joint_step_rad": 0.02,
    "max_gripper_step_m": 0,
    "gripper_effort": 1000,
    "smoothing_alpha": 0.20,
    "cameras": [
      {
        "name": "cam_right",
        "ref": 16
      },
      {
        "name": "cam_side",
        "ref": 6
      },
      {
        "name": "cam_front",
        "ref": 14
      }
    ],
    "pace_by_reach": false,
    "advance_threshold_rad": 0.08,
    "max_hold_steps": 30,
    "print_every": 5,
    "log_jsonl": "auto",
    "omit_error_logs": true
  },
  "cameras": [
    {
      "name": "cam_right",
      "ref": 16
    },
    {
      "name": "cam_side",
      "ref": 6
    },
    {
      "name": "cam_front",
      "ref": 14
    }
  ],
  "preprocessing": {
    "enabled": false,
    "images": {
      "enabled": false,
      "white_balance": true,
      "clahe_clip_limit": 2.0,
      "clahe_tile_grid_size": 8,
      "orange_boost": {
        "enabled": true,
        "hue_range": [5, 25],
        "sat_scale": 1.2,
        "val_scale": 1.05
      }
    },
    "smoothing": {
      "enabled": false,
      "method": "ema",
      "ema_alpha": 0.25,
      "gripper_ema_alpha": 0.35,
      "savgol_window": 7,
      "savgol_polyorder": 2
    }
  }
